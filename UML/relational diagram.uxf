    <panel_attributes>Assignment
--
id: int PK
subject_id: int FK Ref Subject(id)
assessment: string
weighted_mark: float
unweighted_mark: float
mark_weight: float
grade_type: enum[numeric, S, U]
is_exam: bool[false]

UNIQUE(assessment, subject_id)
-- Only one exam per subject (partial unique index or application check)
-- If is_exam=true, this row supplies the exam mark; its mark_weight represents computed exam weight.

ON DELETE CASCADE via subject_id
</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>1070</x>
      <y>650</y>
      <w>580</w>
      <h>180</h>
    </coordinates>
    <panel_attributes>ExamSettings
--
subject_id: int PK FK Ref Subject(id)
ps_exam: bool[false]
ps_factor: float[40]
exam_assignment_id: int FK Ref Assignment(id) NULL
-- Constraint: (exam_assignment_id IS NULL) OR (Assignment.subject_id = subject_id)
-- Ensures selected assignment belongs to same subject.
-- exam weight derived: 100 - SUM(mark_weight WHERE subject_id AND is_exam=false)

UNIQUE(exam_assignment_id)  -- ensures an assignment is not tied to multiple settings
</panel_attributes>
