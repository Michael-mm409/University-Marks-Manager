      <y>700</y>
      <w>260</w>
      <h>50</h>
    </coordinates>
    <panel_attributes>
lt=-
m1=1..*
m2=1</panel_attributes>
    <additional_attributes>240.0;20.0;10.0;20.0</additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>880</x>
      <y>220</y>
      <w>390</w>
      <h>270</h>
    </coordinates>
    <panel_attributes>Assignment
--
Assessment item for a subject (quiz, lab, exam, etc.)
Supports numeric grades and pass/fail (S/U)
--
id: int PK
subject_id: int FK Ref Subject(id) NOT NULL
assessment: string  (e.g., "Quiz 1", "Lab 3")
weighted_mark: float  (contribution to total)
unweighted_mark: float  (raw score)
mark_weight: float  (% of total, e.g., 15)
grade_type: enum[numeric, S, U]
is_exam: bool[false]  (flags final exam)

UNIQUE(assessment, subject_id)
ON DELETE CASCADE via subject_id
</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>1330</x>
      <y>630</y>
      <w>340</w>
      <h>140</h>
    </coordinates>
    <panel_attributes>ExamSettings
--
Pass-scale (PS) exam configuration
PS exams require min 40% to pass
--
id: int PK
subject_id: int FK Ref Subject(id) NOT NULL
ps_exam: bool[false]  (is this a PS exam?)
ps_factor: float[40.0]  (min % required)

UNIQUE(subject_id)  (1:1 with Subject)
ON DELETE CASCADE via subject_id</panel_attributes>
    <additional_attributes/>
  </element>
