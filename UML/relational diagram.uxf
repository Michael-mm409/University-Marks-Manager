UNIQUE(user_id, course_id)
ON DELETE CASCADE via user_id, course_id
bg=#e6f3ff</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>448</x><y>304</y><w>296</w><h>152</h></coordinates><panel_attributes>Course
--
id: int PK
name: string
code: string                                                   CK1
grading_scale_id: int FK Ref GradeScale(id)
