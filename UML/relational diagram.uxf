    <panel_attributes>Examination
--
Final exam record (alternative to Assignment.is_exam)
One exam per subject maximum
--
id: int PK
subject_id: int FK Ref Subject(id) NOT NULL
exam_mark: float[0.0]  (score achieved)
exam_weight: float[100.0]  (% of total)

UNIQUE(subject_id)  (1:1 with Subject)
ON DELETE CASCADE via subject_id</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>420</x>
      <y>70</y>
      <w>240</w>
      <h>150</h>
    </coordinates>
    <panel_attributes>GradeScale
--
Grade bands and GPA mappings
(e.g., HD=85-100=4.0, D=75-84=3.5)
--
id: int PK
scale_name: string[Standard]
grade: string  (e.g., "HD", "D", "P")
label: string  (e.g., "High Distinction")
min_mark: float  (threshold, e.g., 85.0)
gpa_point: float  (e.g., 4.0)
band_type: string[both]  (wam/gpa/both)

UNIQUE(scale_name, grade, band_type)
bg=#f5f5f5
</panel_attributes>
