      <h>160</h>
    </coordinates>
    <panel_attributes>Semester
--
Academic term within a course (e.g., Autumn 2025)
--
id: int PK
name: string  (e.g., "Autumn", "Spring")
year: int 
course_id: int FK Ref Course(id)

UNIQUE(course_id, name, year)
ON DELETE CASCADE via course_id</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>860</x>
      <y>630</y>
      <w>340</w>
      <h>220</h>
    </coordinates>
    <panel_attributes>Subject
--
Course unit enrolled in a semester (e.g., CSCI203)
total_mark computed from assignments + exam
--
id: int PK
subject_code: string  (e.g., "CSCI203")
subject_name: string
semester_id: int FK Ref Semester(id) NOT NULL
total_mark: float[0.0]  (computed)
credit_points: int[6]
sync_subject: bool[false]  (show in all semesters)

UNIQUE(subject_code, semester_id)
ON DELETE CASCADE via semester_id
</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>Relation</id>
    <coordinates>
