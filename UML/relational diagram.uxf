    <panel_attributes>Subject
--
id: int PK
subject_code: string  
subject_name: string
semester_id: int FK Ref Semester(id)
total_mark: float[0.0]
credit_points: int[6]
sync_subject: bool[false]
-- Exam source priority:
-- 1) Assignment where is_exam=true
-- 2) Examination (Legacy) row if present
-- 3) None =&gt; total_mark from assignments only

UNIQUE(semester_id, subject_code)
</panel_attributes>
