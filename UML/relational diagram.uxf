UNIQUE(code)
bg=#e6f3ff</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>824</x><y>296</y><w>288</w><h>128</h></coordinates><panel_attributes>Semester
--
id: int PK
name: string                                                   CK1
year: int                                                           CK1
course_id: int FK Ref Course(id)                         CK1

UNIQUE(course_id, name, year)
ON DELETE CASCADE via course_id
bg=#e6f3ff</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>1216</x><y>744</y><w>352</w><h>184</h></coordinates><panel_attributes>Assignment
--
id: int PK
assessment: string                                             CK1
subject_id: int FK Ref Subject(id) NOT NULL        CK1
weighted_mark: Optional[float]
unweighted_mark: Optional[float]
mark_weight: Optional[float]
grade_type: string[GradeType.NUMERIC]
is_exam: bool[false]

UNIQUE(assessment, subject_id)
ON DELETE CASCADE via subject_id
bg=#e6f3ff</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>776</x><y>504</y><w>360</w><h>176</h></coordinates><panel_attributes>Subject
--
id: int PK
subject_code: string                                            CK1
semester_id: int FK Ref Semester(id) NOT NULL       CK1
subject_name: string
total_mark: float[0.0]
credit_points: int[6]
sync_subject: bool[false]
has_exam: bool[true]

UNIQUE(subject_code, semester_id)
ON DELETE CASCADE via semester_id
bg=#e6f3ff</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>1352</x><y>432</y><w>352</w><h>160</h></coordinates><panel_attributes>SubjectPrerequisite
--
id: int PK
subject_id: int FK Ref Subject(id)
